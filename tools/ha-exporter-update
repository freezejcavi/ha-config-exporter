#!/usr/bin/env bash
set -euo pipefail

REPO_DIR="/addons/ha-config-exporter"
SOURCE_KEY="${HA_EXPORTER_SOURCE_KEY:-$HOME/.ssh/ha_config_exporter_source}"
SOURCE_BRANCH="${HA_EXPORTER_SOURCE_BRANCH:-main}"
APP_SLUG="local_ha_config_exporter"

green='\033[32m'
cyan='\033[36m'
yellow='\033[33m'
red='\033[31m'
reset='\033[0m'

info() { printf "%bINFO%b  %s\n" "$cyan" "$reset" "$*"; }
ok()   { printf "%bOK%b    %s\n" "$green" "$reset" "$*"; }
warn() { printf "%bWARN%b  %s\n" "$yellow" "$reset" "$*"; }
fail() { printf "%bERROR%b %s\n" "$red" "$reset" "$*" >&2; exit 1; }

version_from_config() {
  awk '
    /^version:[[:space:]]*/ {
      value=$0
      sub(/^version:[[:space:]]*/, "", value)
      gsub(/^["'\'' ]+|["'\'' ]+$/, "", value)
      print value
      exit
    }
  ' "$1/config.yaml"
}

[[ -d "$REPO_DIR/.git" ]] || fail "Git checkout not found: $REPO_DIR"
[[ -f "$SOURCE_KEY" ]] || fail "Source SSH key not found: $SOURCE_KEY"

cd "$REPO_DIR"

if [[ -n "$(git status --porcelain)" ]]; then
  fail "Local exporter checkout contains manual changes. Refusing automatic update."
fi

old_sha="$(git rev-parse HEAD)"
old_version="$(version_from_config "$REPO_DIR")"

export GIT_SSH_COMMAND="ssh -i $SOURCE_KEY -o IdentitiesOnly=yes"

info "Checking exporter source..."
git fetch --quiet --prune origin "$SOURCE_BRANCH"

new_sha="$(git rev-parse "origin/$SOURCE_BRANCH")"

if [[ "$new_sha" == "$old_sha" ]]; then
  ok "Already current: $old_version (${old_sha:0:8})"
  exit 0
fi

if ! git merge-base --is-ancestor "$old_sha" "$new_sha"; then
  fail "Remote main is not a fast-forward of the local checkout."
fi

git reset --hard --quiet "$new_sha"
new_version="$(version_from_config "$REPO_DIR")"

ok "Source updated: ${old_sha:0:8} -> ${new_sha:0:8}"

info "Reloading Home Assistant App store..."
ha store reload >/dev/null

if [[ "$new_version" == "$old_version" ]]; then
  ok "Source changed, App version stays $new_version. No rebuild needed."
  exit 0
fi

info "Updating HA Config Exporter: $old_version -> $new_version"
ha apps update "$APP_SLUG"

ok "HA Config Exporter is now $new_version"
